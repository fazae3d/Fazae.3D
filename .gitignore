# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# user-uploaded product images (local disk, dev/demo stage only)
/public/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# auto-generated Prisma reference docs for AI coding assistants (vendor docs, not project code)
/.agents/
/.claude/skills/
/.windsurf/
