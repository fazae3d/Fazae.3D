# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel (produção).
# NUNCA coloque valores reais neste arquivo: ele vai para o repositório.

# --- Banco (Supabase Postgres) ---
DATABASE_URL=            # conexão pelo pooler (usada pelo site)
DIRECT_URL=              # conexão direta (usada pelas migrations e pelo seed)

# --- Login (NextAuth) ---
AUTH_SECRET=             # texto aleatório longo; também assina links de e-mail
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=   # chave secreta do painel de webhooks; obrigatória em produção

# --- E-mail (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=            # ex.: Fazaê <contato@seudominio.com.br> (domínio verificado no Resend)
STORE_CONTACT_EMAIL=          # recebe contato do site e os avisos de pedido/pagamento

# --- Frete (Melhor Envio) ---
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=false

# --- Upload de imagens (Supabase Storage, bucket público "product-images") ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron da Vercel ---
CRON_SECRET=                  # a Vercel envia como "Authorization: Bearer"; obrigatória em produção

# --- Opcional ---
NEXT_PUBLIC_SITE_URL=         # padrão: https://www.fazae3d.com.br

# --- WhatsApp (uazapi): sem isso o painel de conversas funciona em modo simulação ---
UAZAPI_URL=                   # servidor da sua conta, ex.: https://seuservidor.uazapi.com
UAZAPI_TOKEN=                 # token da instância (nunca o admintoken)
WHATSAPP_WEBHOOK_SECRET=      # segredo longo e aleatório; vai na URL do webhook: /api/webhooks/whatsapp?s=SEGREDO
