// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  admin
}

enum ProductType {
  pronta_entrega
  sob_encomenda
}

enum SaleChannel {
  online
  presencial
  whatsapp
  mercado_livre
  shopee
  tiktok_shop
}

enum CustomRequestStatus {
  novo
  em_contato
  orcamento_enviado
  fechado
  perdido
}

enum ProductionStage {
  nao_aplicavel // pedido não precisa de produção (já tinha em estoque)
  inicio // venda confirmada, aguardando produção
  em_producao
  finalizado
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(customer)
  resetToken          String?
  resetTokenExpiresAt DateTime?
  /**
   * Preenchido quando a pessoa prova que é dona do e-mail (link de confirmação, login Google ou redefinição de senha).
   * Enquanto estiver vazio, a conta não vê pedidos: evita que alguém cadastre o e-mail de outra pessoa e leia o histórico dela.
   */
  emailVerifiedAt     DateTime?
  createdAt           DateTime  @default(now())
  addresses           Address[]
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  recipient    String
  cpf          String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zip          String

  @@index([userId])
}

model Category {
  slug        String    @id
  name        String
  description String
  icon        String?
  products    Product[]
}

model Material {
  slug   String @id
  name   String
  /**
   * Available colors for this material, [{ name: "Preto", hex: "#111111" }, ...]
   */
  colors Json
}

model Product {
  slug                    String                 @id
  name                    String
  categorySlug            String
  category                Category               @relation(fields: [categorySlug], references: [slug])
  type                    ProductType
  description             String
  /**
   * Null means "sob consulta", common for sob_encomenda pieces without a fixed price.
   */
  price                   Float?
  compareAtPrice          Float?
  /**
   * Material/color options for this product, [{ material: "PLA", colors: ["Preto", "Branco"] }, ...]
   */
  materials               Json
  scaleOptions            String[]               @default([])
  weightGrams             Int?
  dimensions              String?
  /**
   * Dimensões da caixa de envio (cm), usadas na cotação de frete, distintas
   * de `dimensions` (medida da peça em si, mostrada ao cliente).
   */
  packageWidthCm          Float?
  packageHeightCm         Float?
  packageLengthCm         Float?
  /**
   * Only shown/used when type is sob_encomenda.
   */
  estimatedProductionDays Int?
  /**
   * Only meaningful for pronta_entrega, sob_encomenda pieces are made to order.
   */
  stock                   Int                    @default(0)
  images                  String[]               @default([])
  tags                    String[]               @default([])
  isNew                   Boolean                @default(false)
  isBestSeller            Boolean                @default(false)
  relatedSlugs            String[]               @default([])
  /**
   * Mão de obra/custos fixos por peça, usado no cálculo de custo de produção.
   */
  laborCost               Float?
  /**
   * Tratamento visual da imagem ilustrativa (fitness, surf, street...) usado quando o produto ainda não tem foto.
   */
  imageTone               String?
  /**
   * Rascunho: produto cadastrado mas ainda não publicado. Fica oculto na loja (listas, busca, categorias, sitemap, feed do
   * Google e compra), mas continua aparecendo e editável no painel.
   */
  hidden                  Boolean                @default(false)
  materialUsages          ProductMaterialUsage[]
  reviews                 Review[]
  consignmentItems        ConsignmentItem[]
  productionItems         ProductionItem[]

  @@index([categorySlug])
  @@index([type])
}

model RawMaterial {
  id          String                 @id @default(cuid())
  name        String // "Filamento PLA Preto 1kg"
  unit        String // "g" | "ml" | "un"
  stock       Float                  @default(0)
  costPerUnit Float // custo por 1 unidade de `unit`
  minStock    Float? // aviso de estoque baixo
  createdAt   DateTime               @default(now())
  usages      ProductMaterialUsage[]
}

model ProductMaterialUsage {
  id            String      @id @default(cuid())
  productSlug   String
  product       Product     @relation(fields: [productSlug], references: [slug], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  quantity      Float // consumo por unidade produzida, na unit do insumo

  @@unique([productSlug, rawMaterialId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique // identificador principal (venda por WhatsApp)
  email     String?
  notes     String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  /** Último lembrete de reativação (cliente que não compra há muito tempo) enviado pelo painel. */
  lastReminderAt DateTime?
}

/**
 * Lead captured by the "Fazer orçamento" form at /personalizado.
 */
model CustomOrderRequest {
  id                   String              @id @default(cuid())
  createdAt            DateTime            @default(now())
  name                 String
  phone                String
  email                String?
  description          String
  referenceProductSlug String?
  referenceFileUrl     String?
  materialPreference   String?
  colorPreference      String?
  quantity             Int                 @default(1)
  desiredDeadline      String?
  status               CustomRequestStatus @default(novo)
  adminNotes           String?
  /**
   * Set once the admin closes the sale from this lead, links to the resulting Order.
   */
  linkedOrderId        String?

  @@index([status])
}

model Order {
  id                 String          @id
  createdAt          DateTime        @default(now())
  channel            SaleChannel     @default(online)
  /**
   * Set when this order originated from a CustomOrderRequest closed manually by the admin.
   */
  originRequestId    String?
  userEmail          String?
  customerName       String?
  customerPhone      String?
  items              Json
  subtotal           Float
  shipping           Float
  /**
   * Como o cliente escolheu receber (ex.: "Entrega própria (Motoboy)", "SEDEX (Correios)"). Nulo em pedidos antigos e vendas manuais.
   */
  shippingMethod     String?
  discount           Float
  couponCode         String?
  total              Float
  paymentMethod      String
  /**
   * Status bruto do gateway de pagamento (Mercado Pago): "pending" | "approved" | "in_process" | "rejected".
   * Distinto de `status` (fluxo do pedido em si), pedidos via Pix/boleto ficam "pending" até o webhook confirmar.
   */
  paymentStatus      String          @default("pending")
  /** Id do pagamento no Mercado Pago, usado para reconciliar o webhook com o pedido. */
  mpPaymentId        String?         @unique
  address            Json?
  status             String
  tracking           String?
  productionStage    ProductionStage @default(nao_aplicavel)
  productionDeadline DateTime?
  /**
   * Sinal já recebido, saldo a receber é calculado (total - depositAmount), não armazenado.
   */
  depositAmount      Float           @default(0)
  /**
   * True quando o checkout já baixou o estoque (e os insumos) deste pedido. Só pedidos com a reserva
   * ativa devolvem estoque ao cancelar, pedidos antigos, anteriores à baixa automática, não.
   */
  stockReserved      Boolean         @default(false)
  /**
   * Taxa cobrada pelo Mercado Pago neste pedido (valor pago menos o líquido recebido). Preenchida quando o pagamento é aprovado;
   * vazia em pedidos antigos e vendas lançadas à mão.
   */
  paymentFee         Float?
  /** Quando o lembrete "seu Pix vence hoje" foi enviado (um só por pedido). */
  pixReminderSentAt  DateTime?
  /** Quando foi marcado como "Entregue" (base do pós-venda automático). */
  deliveredAt        DateTime?
  reviews            Review[]
  payments           OrderPayment[]

  @@index([userEmail])
  @@index([createdAt])
  @@index([status])
}

/**
 * Cada vez que o dono registra (valor positivo) ou desfaz/corrige (valor negativo) um recebimento de uma venda lançada no painel.
 * Serve para o "Em caixa" saber em que dia o dinheiro entrou; o valor recebido do pedido continua em Order.depositAmount.
 */
model OrderPayment {
  id      String   @id @default(cuid())
  orderId String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount  Float
  paidAt  DateTime @default(now())

  @@index([orderId])
  @@index([paidAt])
}

model Coupon {
  code        String  @id
  type        String
  value       Float
  minSubtotal Float?
  usageLimit  Int?
  usageCount  Int     @default(0)
  active      Boolean @default(true)
}

/**
 * Singleton row (always id = 1) holding store-wide settings edited in /admin/configuracoes.
 */
model Settings {
  id                      Int     @id @default(1)
  freeShippingThreshold   Float
  whatsappNumber          String
  /**
   * Template for the message pre-filled when a "Fazer orçamento" link opens WhatsApp.
   */
  whatsappMessageTemplate String?
  /**
   * Editable intro copy shown at the top of /personalizado.
   */
  customOrderIntroText    String?
  /**
   * CEP de onde a loja envia, usado como origem na cotação de frete real (Melhor Envio).
   */
  originCep               String?
  /**
   * Pré-preenchem a calculadora de precificação (/admin/precificacao), nunca gravados
   * automaticamente no produto, só servem de ponto de partida editável.
   */
  defaultProfitMarginPct     Float @default(30)
  averageFailureRatePct      Float @default(5)
  printerCostPerHour         Float @default(0)
  energyCostPerHour          Float @default(0)
  defaultMaterialCostPerGram Float @default(0)
  /**
   * Entrega própria (motoboy) em Natal/Parnamirim: grátis a partir de `localDeliveryThreshold`,
   * abaixo disso cobra `localDeliveryFee`.
   */
  localDeliveryThreshold     Float @default(49.9)
  localDeliveryFee           Float @default(12)
  /**
   * Desconto (%) exibido como preço "no Pix" em toda a loja.
   */
  pixDiscountPct             Float @default(5)
  /**
   * Taxas de cada canal de marketplace: { mercado_livre: { pct, fixed }, shopee: {...}, tiktok_shop: {...} }.
   * `pct` = comissão (% do valor vendido); `fixed` = taxa fixa por unidade vendida (R$).
   */
  channelFees                Json  @default("{}")
  /** Meta de faturamento mensal (R$). 0 = sem meta. */
  monthlyGoal               Float @default(0)
  /** Saldo em conta na data `cashBalanceDate` (R$). Vendas recebidas e despesas a partir dessa data movimentam o "Em caixa". */
  cashBalance               Float     @default(0)
  cashBalanceDate           DateTime?
  /** Regras da loja editáveis (frete padrão, prazos, textos, dados da empresa...). Formato e padrões em src/lib/store-rules.ts; vazio = tudo no padrão. */
  rules                     Json?
}

/** Custo extra nomeado e reutilizável (argola, ímã, embalagem...), somado ad-hoc na calculadora de precificação. */
model AdditionalCost {
  id    String @id @default(cuid())
  name  String
  value Float
}

/**
 * "equipamento" é investimento (capex), entra no cálculo de payback, não no DRE operacional.
 * "material" cobre insumos/matéria-prima; "embalagem" e "operacional" (aluguel, energia,
 * marketing, assinaturas...) são despesa operacional recorrente.
 */
enum ExpenseCategory {
  equipamento
  material
  embalagem
  operacional
}

/** Registro de compras/gastos reais, base do módulo Finanças (/admin/financas). */
model Expense {
  id           String          @id @default(cuid())
  description  String
  category     ExpenseCategory
  quantity     Float?
  unitValue    Float?
  totalValue   Float
  purchaseDate DateTime
  notes        String?
  /** Compra no cartão em várias vezes: quantas parcelas (1 = à vista) e o vencimento da primeira (vazio = dia da compra). */
  installments Int             @default(1)
  firstDueDate DateTime?
  createdAt    DateTime        @default(now())

  @@index([purchaseDate])
  @@index([category])
}

/** Avaliação de produto, só pode ser criada por quem tem um pedido entregue com aquele produto. */
model Review {
  id          String   @id @default(cuid())
  productSlug String
  product     Product  @relation(fields: [productSlug], references: [slug], onDelete: Cascade)
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /** Primeiro nome do cliente do pedido, nunca o sobrenome inteiro. */
  authorName  String
  rating      Int
  text        String?
  /**
   * Moderação leve: o admin pode ocultar um review pontual, sem fila de
   * aprovação prévia, a trava de "só quem recebeu o pedido" já filtra spam.
   */
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([orderId, productSlug])
  @@index([productSlug])
}

/** Lojista/revendedor que recebe peças em consignação, com preço combinado à parte do catálogo. */
model Consignee {
  id           String   @id @default(cuid())
  name         String
  document     String // CPF ou CNPJ, sem máscara
  phone        String
  email        String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zip          String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  items        ConsignmentItem[]
  visits       ConsignmentVisit[]
}

/** Saldo atual: quanto de cada produto está fisicamente com cada lojista agora, e a que preço. */
model ConsignmentItem {
  id             String    @id @default(cuid())
  consigneeId    String
  consignee      Consignee @relation(fields: [consigneeId], references: [id], onDelete: Cascade)
  productSlug    String
  product        Product   @relation(fields: [productSlug], references: [slug])
  consignedPrice Float
  /** Quantidade atualmente com o lojista, entrega soma, venda/devolução subtrai. */
  quantity       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([consigneeId, productSlug])
  @@index([consigneeId])
}

/** Log de visitas ao lojista, histórico de acerto e agenda da próxima visita. */
model ConsignmentVisit {
  id              String    @id @default(cuid())
  consigneeId     String
  consignee       Consignee @relation(fields: [consigneeId], references: [id], onDelete: Cascade)
  visitDate       DateTime
  nextVisitDate   DateTime?
  /** Valor recebido nessa visita (referente ao que foi vendido desde a última). */
  amountCollected Float     @default(0)
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([consigneeId])
}

/**
 * Snapshot do carrinho de quem passou do passo de identificação do checkout
 * (e-mail já conhecido) mas não finalizou a compra. Sobrescrito (upsert por
 * email) a cada nova tentativa de checkout, zera remindedAt, então um novo
 * abandono depois de já ter recebido lembrete é elegível de novo. Apagado
 * quando o checkout é concluído com sucesso.
 */
model AbandonedCart {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  /** Mesmo shape de Order.items (OrderItem[]), preço/nome já resolvidos no momento da captura. */
  items      Json
  subtotal   Float
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  remindedAt DateTime?
  /** Quantos lembretes já saíram (1 = primeiro e-mail, 2 = segundo com incentivo); zera quando a pessoa mexe no carrinho de novo. */
  reminderCount Int @default(0)

  @@index([remindedAt])
}

/**
 * Campanha de e-mail (novidades/ofertas) montada no painel e enviada aos contatos que aceitaram receber.
 * status: "rascunho" (editável), "enviando" (em andamento), "parcial" (parte dos e-mails não saiu: dá para reenviar só aos que faltam)
 * ou "enviada".
 */
model Campaign {
  id          String             @id @default(cuid())
  subject     String
  heading     String
  /** Texto do e-mail: parágrafos separados por linha em branco; linhas começando com "- " viram lista. */
  body        String
  buttonLabel String?
  buttonUrl   String?
  status      String             @default("rascunho")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  sentAt      DateTime?
  deliveries  CampaignDelivery[]
}

/** Resultado de envio por destinatário: evita mandar duas vezes a mesma campanha para a mesma pessoa. */
model CampaignDelivery {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      String
  /** "enviado" ou "erro". */
  status     String
  error      String?
  createdAt  DateTime @default(now())

  @@unique([campaignId, email])
}

/**
 * Contatos que aceitaram receber novidades e ofertas (rodapé da loja, home ou caixa do checkout).
 * O consentimento fica registrado com data e origem (LGPD); `unsubscribedAt` preenchido = não enviar mais.
 */
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  whatsapp       String?
  /** Onde a pessoa se inscreveu: "rodape", "home" ou "checkout". */
  source         String
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

/**
 * Item de produção sem pedido associado, peça feita por conta própria
 * (estoque, amostra, teste), fora do fluxo normal onde a produção nasce
 * de um Order. Aparece no mesmo board de /admin/producao, lado a lado
 * com os pedidos reais.
 */
model ProductionItem {
  id          String          @id @default(cuid())
  productSlug String?
  product     Product?        @relation(fields: [productSlug], references: [slug])
  description String
  quantity    Int             @default(1)
  stage       ProductionStage @default(inicio)
  deadline    DateTime?
  notes       String?
  /**
   * Quantas unidades já foram somadas ao estoque do produto quando o item foi marcado como finalizado
   * (zerado se voltar para uma fase anterior). Garante que o estoque só aumenta uma vez por item.
   */
  stockAddedQty Int           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([stage])
}

/** E-mails que pediram para não receber lembretes (carrinho abandonado). */
model EmailOptOut {
  email     String   @id
  createdAt DateTime @default(now())
}

/** Contadores do limite de tentativas, compartilhados entre todas as instâncias do servidor. */
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime
}

/** Registro de ações sensíveis feitas no painel (quem apagou/cancelou/alterou o quê e quando). */
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorEmail String
  action     String
  targetType String
  targetId   String
  details    Json?
  /** "event" (ação com nome, ex.: pedido.pago) | "create" | "update" | "delete" (registro automático de cada mudança, com antes e depois). */
  kind       String   @default("event")
  /** Lista do que mudou: [{ field, from, to }]. */
  changes    Json?
  before     Json?
  after      Json?
  /** Quando esta mudança foi desfeita pelo painel, e por quem. */
  restoredAt DateTime?
  restoredBy String?

  @@index([at])
  @@index([targetType, targetId])
  @@index([actorEmail])
  @@index([kind])
}

enum QuoteStatus {
  rascunho
  enviado
  aprovado
  recusado
}

/**
 * Orçamento montado no painel para enviar ao cliente (PDF + link público). "Vencido" não é um status gravado:
 * é calculado a partir de `validUntil` enquanto o orçamento ainda está em rascunho/enviado.
 */
model Quote {
  id               String      @id @default(cuid())
  /** Número sequencial exibido como ORC-0001. */
  number           Int         @unique @default(autoincrement())
  /** Segredo do link público (/orcamento/<token>), quem tem o link vê e baixa o PDF. */
  token            String      @unique @default(cuid())
  status           QuoteStatus @default(rascunho)
  customerName     String
  customerPhone    String?
  customerEmail    String?
  customerDocument String?
  customerAddress  String?
  /** Título do projeto/pedido (ex.: "Brindes personalizados para evento"). */
  title            String?
  /** [{ description, details?, quantity, unitPrice, imageUrl?, productSlug? }] */
  items            Json
  subtotal         Float
  discount         Float       @default(0)
  shipping         Float       @default(0)
  /** Frete grátis para o cliente: sai "GRÁTIS" no orçamento, com o valor normal riscado (shippingOriginal) para evidenciar a economia. */
  freeShipping     Boolean     @default(false)
  shippingOriginal Float       @default(0)
  total            Float
  validUntil       DateTime
  deliveryTime     String?
  paymentTerms     String?
  notes            String?
  sentAt           DateTime?
  decidedAt        DateTime?
  /** Lead (CustomOrderRequest) que originou o orçamento, e o pedido gerado ao aprovar. */
  linkedRequestId  String?
  linkedOrderId    String?
  /** Último contato de acompanhamento ("viu o orçamento?") feito pelo painel. */
  lastFollowUpAt   DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

/**
 * Conversa de WhatsApp (uma por telefone) com os dados do lead: etapa do funil, etiquetas e observações.
 * O telefone fica só com dígitos e DDI (ex.: 5584999998888).
 */
model WaConversation {
  id            String         @id @default(cuid())
  phone         String         @unique
  name          String?
  /** "entrada" = chamou primeiro | "prospeccao" = lista fria | "cliente" */
  source        String         @default("entrada")
  /** novo | contato | interessado | proposta | ganho | perdido */
  stage         String         @default("novo")
  tags          String[]       @default([])
  notes         String?
  /** Pediu para não receber mais mensagens: nenhuma automação pode escrever para esse número. */
  optedOut      Boolean        @default(false)
  unreadCount   Int            @default(0)
  lastMessageAt DateTime?
  lastPreview   String?
  lastInboundAt DateTime?
  /** Quem mandou a última mensagem: "in" (cliente, aguardando resposta nossa) ou "out". */
  lastDirection String?
  /** O número tem WhatsApp? Vazio = ainda não conferido. */
  hasWhatsapp   Boolean?
  /** Próxima ação combinada (ex.: "ligar quinta") e quando. */
  nextActionAt   DateTime?
  nextActionNote String?
  /** Última resposta automática (saudação/fora do horário), para não repetir. */
  lastAutoReplyAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  messages      WaMessage[]
  enrollments   WaEnrollment[]

  @@index([lastMessageAt])
  @@index([stage])
  @@index([lastDirection])
  @@index([nextActionAt])
}

model WaMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /** "in" (cliente) | "out" (nós) */
  direction      String
  body           String
  /** image | audio | video | document... quando não é só texto (o painel mostra um aviso no lugar do arquivo). */
  mediaType      String?
  /** Endereço do arquivo recebido (imagem, áudio, documento) quando o provedor informa. */
  mediaUrl       String?
  /** Cadência e passo que originaram a mensagem (para medir resultado por cadência). */
  cadenceId      String?
  stepIndex      Int?
  /** Chave de idempotência de avisos automáticos (ex.: "pedido:FAZ-1:pago"): nunca manda o mesmo aviso duas vezes. */
  ref            String?        @unique
  /** Id da mensagem no WhatsApp/provedor: evita registrar a mesma mensagem duas vezes. */
  providerId     String?        @unique
  /** queued | sent | delivered | read | failed */
  status         String         @default("queued")
  /** manual | cadencia | campanha | celular (enviada direto do aparelho) | cliente */
  origin         String         @default("manual")
  error          String?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@index([cadenceId])
}

/** Sequência de mensagens automáticas. steps = [{ delayHours, text }]: o 1º passo sai ao entrar; os demais depois de delayHours do anterior. */
model WaCadence {
  id          String         @id @default(cuid())
  name        String
  /** prospeccao | orcamento | pos_venda | reativacao | personalizada */
  kind        String         @default("personalizada")
  active      Boolean        @default(true)
  steps       Json
  /** Dias da semana em que pode enviar (0 = domingo ... 6 = sábado). */
  sendDays        Int[]    @default([1, 2, 3, 4, 5, 6])
  /** Janela de horário própria desta cadência; vazio = usa a regra geral (WaConfig). */
  windowStartHour Int?
  windowEndHour   Int?
  /** Coloca sozinha na cadência quem combina com `audience` (ver lib/wa-cadence.ts). */
  autoEnroll      Boolean  @default(false)
  audience        Json?
  /** Depois de quantos dias de concluída quem não respondeu pode entrar de novo (vazio = não repete). */
  repeatAfterDays Int?
  createdAt   DateTime       @default(now())
  enrollments WaEnrollment[]
}

model WaEnrollment {
  id             String         @id @default(cuid())
  cadenceId      String
  cadence        WaCadence      @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  stepIndex      Int            @default(0)
  nextRunAt      DateTime?
  /** ativa | concluida | parada */
  status         String         @default("ativa")
  stopReason     String?
  /** Tentativas de envio que falharam no passo atual (depois de 3, a inscrição é parada). */
  attempts       Int            @default(0)
  /** Quando terminou todas as mensagens (base para a repetição). */
  finishedAt     DateTime?
  /** Quantas vezes já passou por esta cadência. */
  rounds         Int            @default(1)
  createdAt      DateTime       @default(now())

  @@unique([cadenceId, conversationId])
  @@index([status, nextRunAt])
}

/** Regras do envio automático (cadências). Linha única (id = 1). Nasce DESLIGADA: nada sai sozinho até o dono ligar. */
model WaConfig {
  id              Int     @id @default(1)
  autoSendEnabled Boolean @default(false)
  /** Teto de mensagens automáticas por dia (cadências + campanhas). */
  dailyLimit      Int     @default(100)
  /** Janela de envio, em horas do fuso da loja (segunda a sábado). */
  windowStartHour Int     @default(8)
  windowEndHour   Int     @default(18)
  /** Pausa automática (disjuntor): preenchido quando o envio foi desligado por falhas seguidas. */
  pausedReason    String?
  pausedAt        DateTime?
  /** Último evento recebido do WhatsApp (para avisar quando o webhook para de chegar). */
  lastWebhookAt   DateTime?
  /** Respostas automáticas ao cliente: fora do horário de atendimento e saudação de contato novo. */
  awayEnabled     Boolean @default(false)
  awayText        String?
  greetingEnabled Boolean @default(false)
  greetingText    String?
  /** Avisos de pedido por WhatsApp (pagamento aprovado, enviado, Pix vencendo). */
  orderNotifyEnabled Boolean @default(false)
  orderTemplates     Json?
}

/** Resposta rápida do atendimento: digite "/atalho" no chat e o texto entra no campo de mensagem. */
model WaQuickReply {
  id        String   @id @default(cuid())
  title     String
  /** Sem barra, minúsculo, sem acento (ex.: "prazo"). */
  shortcut  String   @unique
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
